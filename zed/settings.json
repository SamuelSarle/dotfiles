{
  "buffer_line_height": "standard",
  "git_panel": {
    "dock": "left",
  },
  "use_system_path_prompts": true,
  "file_finder": {
    "modal_max_width": "medium",
  },
  "scrollbar": {
    "show": "system",
    "diagnostics": "all",
    "axes": {
      "horizontal": true,
      "vertical": true,
    },
  },
  "minimap": {
    "current_line_highlight": "all",
    "thumb": "always",
    "display_in": "active_editor",
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": true,
    "agent_review": true,
    "code_actions": true,
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 2,
    "active_line_width": 2,
    "coloring": "fixed",
    "background_coloring": "disabled",
  },
  "outline_panel": {
    "dock": "left",
    "button": true,
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
    "git_gutter": "tracked_files",
  },
  "window_decorations": "client",
  "bottom_dock_layout": "contained",
  "tabs": {
    "show_close_button": "hover",
    "show_diagnostics": "errors",
    "close_position": "left",
    "git_status": true,
    "file_icons": true,
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_root": false,
    "auto_fold_dirs": true,
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "entry_spacing": "comfortable",
    "hide_gitignore": false,
    "dock": "left",
    "button": true,
  },
  "title_bar": {
    "show_onboarding_banner": true,
    "show_user_picture": false,
    "show_menus": false,
    "show_sign_in": false,
  },
  "completion_menu_scrollbar": "auto",
  "agent": {
    "dock": "right",
    "profiles": {
      "ask": {
        "name": "Ask",
        "tools": {
          "search_web": true,
          "contents": true,
          "diagnostics": true,
          "fetch": true,
          "list_directory": true,
          "project_notifications": false,
          "now": true,
          "find_path": true,
          "read_file": true,
          "open": true,
          "grep": true,
          "thinking": true,
          "copy_path": false,
        },
        "enable_all_context_servers": false,
        "context_servers": {},
      },
    },
    "default_profile": "write",
    // "always_allow_tool_actions": true,
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-latest",
    },
  },

  "theme": {
    "mode": "system",
    "dark": "Fleet Dark",
    "light": "Fleet Light",
  },
  "buffer_font_size": 16.0,
  "ui_font_size": 15,
  "ui_font_weight": 600,
  "buffer_font_weight": 500.0,
  "ui_font_family": "FiraCode Nerd Font",
  "buffer_font_family": "FiraCode Nerd Font",
  "ui_font_features": {
    "calt": false,
  },
  "buffer_font_features": {
    "calt": false,
  },
  "use_system_window_tabs": true,

  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": false,
    "use_smartcase_find": true,
  },
  "use_smartcase_search": true,
  "pane_split_direction_horizontal": "down",
  "pane_split_direction_vertical": "right",
  "terminal": {
    "shell": { "program": "/opt/homebrew/bin/fish" },
    "detect_venv": "off",
  },

  "languages": {
    "Python": {
      "indent_guides": {}
    },
    "Rust": {
      "inlay_hints": {
        "show_parameter_hints": true,
        "show_background": false,
        "show_type_hints": true,
        "enabled": false,
      },
    },
  },

  // disable some defaults
  "show_edit_predictions": false,
  "collaboration_panel": { "dock": "left", "button": false },
  "tab_bar": { "show": false },
  // "toolbar": { "quick_actions": true },
  "telemetry": { "diagnostics": false, "metrics": false },
  "auto_update": false,
}
